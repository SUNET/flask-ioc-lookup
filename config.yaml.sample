MISP_URL: 'https://misp-instance/'
MISP_KEY: 'secret'
MISP_VERIFYCERT: true
STATIC_FILES: 'static/'
# Required. Can also be set with environment variable IOC_LOOKUP_SECRET_KEY (takes precedence).
# SECRET_KEY: 'change-me-to-a-long-random-string'
# Slack app signing secret. Can also be set with environment variable IOC_LOOKUP_SLACK_SIGNING_SECRET
# (takes precedence). The Slack endpoint is exempt from CSRF checks only if this is set and the request's
# Slack signature verifies; without it Slack requests are rejected.
# SLACK_SIGNING_SECRET: 'slack-signing-secret'
# Origins allowed to submit browser forms, defaults to the request's own scheme://host.
# TRUSTED_ORIGINS:
#   - 'https://ioc.example.org'
# [count] [per|/] [n (optional)] [second|minute|hour|day|month|year]
# ex '1/second;10/hour;100/day;2000 per year'
REQUEST_RATE_LIMIT: '1/second'
# Optional separate limit for the Slack endpoint, counted per Slack workspace. Defaults to REQUEST_RATE_LIMIT.
# SLACK_RATE_LIMIT: '10/minute'
# for more caching options see, https://flask-caching.readthedocs.io
CACHE_TYPE: 'SimpleCache'
CACHE_DEFAULT_TIMEOUT: 300  # seconds
TRUSTED_USERS: '/path/to/trusted_users.yaml'
TRUSTED_ORGS: '/path/to/trusted_orgs.yaml'
LOG_LEVEL: INFO
LOG_COLORIZE: false
# limit date span for related results, null for no limit
LIMIT_DAYS_RELATED_RESULTS: 365  # days
# limit number of related results, null for all
LIMIT_RELATED_RESULTS: 10
# disable sightings as a workaround with false
SIGHTINGS_ENABLED: true
ALLOWED_EVENT_TAGS:
  - "type:OSINT"
  - "Phishing"
  - "Malware"
  - "C2"
